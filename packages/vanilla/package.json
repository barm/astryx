{
  "name": "@astryxdesign/vanilla",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental no-build Astryx styles and behaviors",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "markup",
    "elements-markup",
    "elements-templates"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-elements.mjs",
    "build:elements": "node scripts/build-elements.mjs",
    "check": "node scripts/build.mjs --check && node scripts/build-elements.mjs --check",
    "check:elements": "node scripts/build-elements.mjs --check",
    "demo": "node scripts/render-demo.mjs",
    "test": "node --test",
    "test:browser": "node src/js/browser-test.mjs",
    "test:elements:browser": "node elements/test/browser.test.mjs"
  }
}
