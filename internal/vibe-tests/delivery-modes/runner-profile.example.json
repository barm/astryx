{
  "schema": 1,
  "runners": {
    "runner-a": {
      "command": "/path/to/runner-a",
      "input": "stdin",
      "agentArgs": [
        "run",
        "--tools",
        "{{TOOLS}}",
        "--config",
        "{{MCP_CONFIG}}"
      ],
      "judgeArgs": [
        "judge",
        "--tools",
        "{{TOOLS}}",
        "--schema",
        "{{JSON_SCHEMA}}"
      ],
      "audit": {
        "versionPath": "runner_version",
        "contextPolicies": {
          "REPLACE_ME_VERSION": {
            "agents": ["REPLACE_ME_AGENT"],
            "plugins": [
              {
                "name": "REPLACE_ME_PLUGIN",
                "path": "REPLACE_ME_PATH",
                "source": "REPLACE_ME_SOURCE"
              }
            ]
          }
        },
        "requiredStderr": ["REPLACE_ME_READY_MARKER"],
        "pluginInstallMarker": "REPLACE_ME_INSTALL_MARKER",
        "knownAsymmetry": "REPLACE_ME_RUNNER_A_ASYMMETRY",
        "projectInstructions": "REPLACE_ME_PROJECT_INSTRUCTION_BEHAVIOR",
        "pathPolicy": "REPLACE_ME_PATH_POLICY"
      },
      "transcript": {
        "format": "jsonl",
        "toolCalls": [
          {
            "recordsPath": "message.items",
            "matches": [
              {
                "path": "kind",
                "equals": "command"
              }
            ],
            "commandPath": "input.command"
          }
        ],
        "usage": {
          "matches": [
            {
              "path": "kind",
              "equals": "usage"
            }
          ],
          "inputTokensPath": "metrics.input",
          "outputTokensPath": "metrics.output"
        }
      }
    },
    "runner-b": {
      "command": "/path/to/runner-b",
      "input": "none",
      "maxModelSteps": 80,
      "agentArgs": [
        "run",
        "--workspace",
        "{{PROJECT}}",
        "--task",
        "{{TASK_FILE}}",
        "--steps",
        "{{MAX_MODEL_STEPS}}"
      ],
      "audit": {
        "pluginGateOffMarker": "REPLACE_ME_GATE_MARKER",
        "pluginInstallMarker": "REPLACE_ME_INSTALL_MARKER",
        "knownAsymmetry": "REPLACE_ME_RUNNER_B_ASYMMETRY",
        "pathPolicy": "REPLACE_ME_PATH_POLICY",
        "transcriptEvents": {
          "reminders": {
            "matches": [
              {
                "path": "kind",
                "equals": "reminder"
              }
            ],
            "valuePath": "event.name"
          },
          "externalContext": {
            "matches": [
              {
                "path": "kind",
                "equals": "external-context"
              }
            ]
          }
        }
      },
      "transcript": {
        "format": "jsonl",
        "toolCalls": [
          {
            "matches": [
              {
                "path": "kind",
                "equals": "work-proposed"
              },
              {
                "path": "event.category",
                "startsWith": "tool."
              }
            ]
          }
        ],
        "commands": [
          {
            "matches": [
              {
                "path": "kind",
                "equals": "work-output"
              },
              {
                "path": "event.complete",
                "equals": true
              }
            ],
            "commandPath": "event.detail",
            "commandFormat": "json",
            "commandJsonPath": "command"
          }
        ],
        "usage": {
          "matches": [
            {
              "path": "kind",
              "equals": "usage"
            }
          ],
          "inputTokensPath": "metrics.input",
          "outputTokensPath": "metrics.output"
        }
      }
    }
  },
  "sandbox": {
    "mountScript": "set -eu\necho 'replace with the local mount-namespace launcher' >&2\nexit 64",
    "probeScript": "set -eu\necho 'replace with the local isolation probe' >&2\nexit 64",
    "hostUserRoot": "/path/to/host/users",
    "privateDirectories": ["home/.runner-a"],
    "transcriptAuditPaths": ["/path/to/sensitive/root"],
    "manifest": {
      "runnerContext": {
        "runner-a": "REPLACE_ME_RUNNER_A_CONTEXT",
        "runner-b": "REPLACE_ME_RUNNER_B_CONTEXT"
      },
      "isolation": {
        "summary": "REPLACE_ME_ISOLATION_SUMMARY"
      }
    },
    "probeReceipt": {
      "configuredChecksPassed": true
    }
  },
  "projectInstructionFiles": [
    {
      "path": ".runner-a/INSTRUCTIONS.md",
      "heading": "# RUNNER INSTRUCTIONS"
    }
  ],
  "versionCommands": {
    "node": {
      "command": "/path/to/node",
      "args": ["--version"]
    },
    "runnerB": {
      "command": "/path/to/runner-b",
      "args": ["--version"]
    }
  }
}
